// Peptide Command Center — data model
//
// Multi-tenant from the ground up: every row that belongs to a customer's
// workspace hangs off Organization, so the same schema serves both "internal
// use for my own brands" and "sold as a SaaS to other store owners" without
// a rewrite.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Long-lived key shown on the Webhooks/Settings page. The WP plugin uses
  // this once, on first install, to self-register the site as a new Brand —
  // this is the "automatic recognition of new websites" handshake.
  apiKey    String   @unique @default(cuid())
  plan      Plan     @default(TRIAL)
  createdAt DateTime @default(now())

  memberships Membership[]
  brands      Brand[]
  products    Product[]
  contacts    Contact[]
  affiliates  Affiliate[]
  orders      Order[]
  webhookLogs WebhookEvent[]
  coupons     Coupon[]
  customers   Customer[]
  pages       Page[]
  supportTickets SupportTicket[]
  connectedAccounts ConnectedAccount[]
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  AGENCY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// Brands (one row per connected WooCommerce store)
// ---------------------------------------------------------------------------

model Brand {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name   String
  slug   String // e.g. "brand_alpha" — used as the ?store= query param
  domain String

  status         BrandStatus @default(PENDING)
  // Generated when the site self-registers via the plugin; the plugin signs
  // every subsequent webhook with this so the ingestion endpoint can verify
  // it came from this specific store (see /webhooks page + HMAC note there).
  webhookSecret  String      @default(cuid())
  wooConsumerKey String?
  wooConsumerSecret String?

  // ── Network / reseller fields (added for the storefront network) ──────
  subdomain        String?  @unique // <subdomain>.PLATFORM_ROOT_DOMAIN, instant store URL
  customDomain     String?  @unique // reseller-pointed domain, once verified
  templateId       String   @default("classic") // which pre-made React template renders this store
  themeTokens      Json?    // per-brand colour/logo/copy overrides (see lib/brand-theme.ts)
  plan             Plan     @default(TRIAL) // the RESELLER's own subscription tier
  defaultMarkupBps Int      @default(4000)  // 40% default markup over wholesale, in basis points
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())

  // ── Shop/store profile, used to style marketing emails and shown on the storefront ──
  logoUrl          String? // shown in the CRM UI and used as the header image in marketing emails
  supportEmail     String? // public contact address; also the reply-to on marketing emails
  senderName       String? // "From" display name on marketing emails, e.g. "EVLV Team"
  emailAccentColor String? // hex, e.g. "#B8875A" — used for buttons/links in marketing email templates
  businessAddress  String? // physical mailing address, required on marketing emails for CAN-SPAM compliance

  @@unique([organizationId, slug])
  products      StoreMapping[]
  contactLinks  ContactBrandLink[]
  orders        Order[]
  webhookEvents WebhookEvent[]
  trackingConfig TrackingConfig?
  shippingConfig ShippingConfig?
  brandProducts  BrandProduct[]
}

enum BrandStatus {
  PENDING // API key issued, plugin not yet installed / no successful sync
  CONNECTED
  ERROR
}

// ---------------------------------------------------------------------------
// Master product catalog
// ---------------------------------------------------------------------------

model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  sku          String
  chemicalName String
  cogsCents    Int
  masterStock  Int    @default(0)

  // ── Direct storefront catalog fields ────────────────────────────────
  // Populated now that the CRM/CMS is the storefront's own product source
  // (no more WooCommerce in front of it). Optional so existing
  // webhook-ingested rows (from a still-connected external Brand) don't
  // need to backfill these before the schema migrates.
  slug              String?
  name              String?
  category          String?
  spec              String? // e.g. "10 mg / vial"
  purity            String? // e.g. "99.52%"
  description       String? @db.Text
  shortDescription  String? @db.Text
  images            Json? // string[] of image URLs, first = primary
  priceCents        Int?
  compareAtCents    Int?
  inStock           Boolean @default(true)
  featured          Boolean @default(false)
  hidden            Boolean @default(false)

  // ── SEO ──────────────────────────────────────────────────────────────
  seoTitle       String?
  seoDescription String? @db.Text
  seoImage       String?

  coas          CoaDocument[]
  storeMappings StoreMapping[]
  brandProducts BrandProduct[]
  orderItems    OrderItem[]
  reviews       Review[]

  createdAt DateTime @default(now())

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
}

model Review {
  id             String   @id @default(cuid())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  rating         Int
  reviewerName   String
  reviewerEmail  String
  body           String   @db.Text
  approved       Boolean  @default(true)
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Coupons (native to the CRM/CMS now — no WooCommerce coupon API)
// ---------------------------------------------------------------------------

model Coupon {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  code           String
  discountType   DiscountType
  amount         Float // percent (0-100) or a flat dollar amount, per discountType
  minSubtotalCents Int?
  maxDiscountCents Int?
  usageLimit     Int?
  usageCount     Int          @default(0)
  freeShipping   Boolean      @default(false)
  active         Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, code])
}

enum DiscountType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Storefront customer accounts (separate from staff Users, who log into
// the CRM/CMS dashboard). Simple bearer-token sessions, mirroring the
// contract the old nvr-account WP plugin exposed (/login, /register, /me)
// so the frontend's account pages barely had to change.
// ---------------------------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  email          String
  passwordHash   String
  name           String?
  marketingOptIn Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

// ---------------------------------------------------------------------------
// CMS pages / blog posts — the "CRM becomes the CMS too" content layer.
// ---------------------------------------------------------------------------

model Page {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  type        PageType @default(BLOG_POST)
  slug        String
  title       String
  excerpt     String?  @db.Text
  body        String   @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── SEO ──────────────────────────────────────────────────────────────
  seoTitle       String?
  seoDescription String? @db.Text
  seoImage       String?

  @@unique([organizationId, slug])
}

enum PageType {
  BLOG_POST
  STATIC_PAGE
}

model CoaDocument {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  label     String? // e.g. lot/batch number
  createdAt DateTime @default(now())
}

// Links a master Product to its listing on one specific brand's store.
model StoreMapping {
  id                String  @id @default(cuid())
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  brand             Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String
  externalProductId String // WooCommerce product ID on that store
  storePriceCents   Int?

  @@unique([brandId, externalProductId])
}

// ---------------------------------------------------------------------------
// Contacts (unified customer identity across brands)
// ---------------------------------------------------------------------------

model Contact {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String
  createdAt      DateTime     @default(now())

  brandLinks ContactBrandLink[]
  orders     Order[]

  @@unique([organizationId, email])
}

// Per-brand customer identity, so the same email on two WooCommerce stores
// resolves to one Contact but we still know the store-local customer id.
model ContactBrandLink {
  id                 String  @id @default(cuid())
  contact            Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String
  brand              Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId            String
  externalCustomerId String?

  @@unique([contactId, brandId])
}

// ---------------------------------------------------------------------------
// Tracking, pixels & connected accounts
// ---------------------------------------------------------------------------

// One row per brand. IDs entered here get injected into the storefront's
// <head> automatically (see src/lib/tracking.ts + (site)/layout.tsx) — no
// manual code edits or redeploy needed to turn a pixel on.
model TrackingConfig {
  id                String   @id @default(cuid())
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String   @unique
  metaPixelId       String?
  tiktokPixelId     String?
  ga4MeasurementId  String?
  googleAdsId       String?
  customHeadScript  String?  @db.Text
  updatedAt         DateTime @updatedAt
}

// Social/marketing accounts connected for the "pull data into one spot"
// dashboards (Social Analytics, Reddit Marketing, AI Blog Tool). Storing the
// handle/credential here is the "connect" step; actually pulling live
// metrics needs that platform's own developer API app + OAuth token, which
// has to be created on Meta/TikTok/Reddit's side first — this table is
// where that token would be saved once you have one.
model ConnectedAccount {
  id             String   @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  platform       String   // "instagram" | "tiktok" | "x" | "facebook" | "reddit" | "google_business"
  handle         String?
  accessToken    String?  @db.Text
  status         String   @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | ERROR
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, platform])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

// One row per brand, editable from /admin/shipping. Checkout always reads
// this server-side to price the selected method — the client only ever
// shows what this table says, never sets its own price.
model ShippingConfig {
  id                  String   @id @default(cuid())
  brand               Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId             String   @unique
  freeThresholdCents  Int      @default(35000) // subtotal at/above this = free standard shipping
  standardCents       Int      @default(1500)  // standard, below the free threshold
  expeditedCents      Int      @default(2500)  // FedEx 2-Day
  overnightCents      Int      @default(7500)  // FedEx Overnight, US only, <24h
  internationalCents  Int      @default(7500)  // DHL, flat rate, any non-US destination (CA/GB for now)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id             String            @id @default(cuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  contactEmail   String
  subject        String
  message        String            @db.Text
  status         SupportStatus     @default(OPEN)
  orderRef       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  replies        SupportReply[]
}

model SupportReply {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  body      String        @db.Text
  fromStaff Boolean       @default(true)
  createdAt DateTime      @default(now())
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  contact        Contact?     @relation(fields: [contactId], references: [id])
  contactId      String?

  externalOrderNumber String
  status              OrderStatus
  couponCode          String?
  grossCents          Int
  netProfitCents      Int?
  placedAt            DateTime

  // ── Direct-checkout fields (order placed on our own storefront, not
  // relayed from an external WooCommerce webhook). Nullable because
  // webhook-ingested orders from any still-connected external Brand
  // won't carry these. ──────────────────────────────────────────────
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json?
  paymentMethod   String? // "zelle" | "cashapp" | "venmo"
  paymentMemo     String?
  customerNote    String?
  shippingMethod  String? // "standard" | "expedited" | "overnight"
  shippingCents   Int      @default(0)

  items       OrderItem[]
  attribution AffiliateOrderAttribution?

  createdAt DateTime @default(now())

  @@unique([brandId, externalOrderNumber])
}

enum OrderStatus {
  PENDING
  COMPLETED
  PROCESSING
  ON_HOLD
  REFUNDED
  CANCELLED
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product? @relation(fields: [productId], references: [id])
  productId     String?
  sku           String
  name          String
  quantity      Int
  unitPriceCents Int
}

// ---------------------------------------------------------------------------
// Affiliates
// ---------------------------------------------------------------------------

model Affiliate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name        String
  slug        String
  ratePercent Float
  couponCode  String

  attributions AffiliateOrderAttribution[]
  createdAt    DateTime                     @default(now())

  @@unique([organizationId, slug])
}

model AffiliateOrderAttribution {
  id            String    @id @default(cuid())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId   String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  commissionCents Int
}

// ---------------------------------------------------------------------------
// Webhook ingestion log (every inbound call from a store, verified or not)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id])
  brandId        String?

  topic           String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Per-brand pricing (network resellers): which master SKUs a store carries,
// and at what retail. Product.cogsCents stays the WHOLESALE cost the reseller
// pays you; retailPriceCents is what that store's buyer pays. A brand with no
// BrandProduct rows falls back to global master pricing (see lib/catalog.ts).
// ---------------------------------------------------------------------------

model BrandProduct {
  id               String   @id @default(cuid())
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId          String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  retailPriceCents Int
  compareAtCents   Int?
  carried          Boolean  @default(true)  // hide/show this SKU in this store
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([brandId, productId])
  @@index([brandId, carried])
}
