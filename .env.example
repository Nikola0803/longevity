# Postgres connection string. Self-hosted only — no external DB provider.
# Local dev: postgresql://postgres:yourpassword@localhost:5432/postgres
# VPS (Postgres running on the same server as the app): same format, still
# localhost, since the app and DB live on the same machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peptides_crm"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# Shared secret the WordPress plugin sends in its X-CC-Signature HMAC header
# on every webhook call, so the ingestion endpoint can verify authenticity
# per-brand. Generated per-organization at connect time (see /webhooks page).
# Also reused (falling back from NEXTAUTH_SECRET) to sign storefront
# customer session tokens — see src/lib/customer-auth.ts.
WEBHOOK_SIGNING_SECRET="replace-with-a-random-32-byte-string"

# Which Organization/Brand row the public Vertalis storefront reads and
# writes against (products, checkout, coupons, accounts). Matches the slugs
# prisma/seed.ts creates; only change these if you rename that brand or add
# a second storefront sharing this same CRM/CMS.
STORE_ORG_SLUG="vertalis"
STORE_BRAND_SLUG="vertalis"

# ── Storefront network (onboarding + multi-tenant hosting) ────────────────────
# Reseller stores are served at <subdomain>.PLATFORM_ROOT_DOMAIN. Leave blank in
# dev (subdomains resolve on *.localhost automatically).
PLATFORM_ROOT_DOMAIN=""
# Public copy of the above, shown in the onboarding preview. Dev: localhost:3000.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN="localhost:3000"
# Organization that owns the shared catalog new reseller brands sell.
PLATFORM_ORG_SLUG="vertalis"
